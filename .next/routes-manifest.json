{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/scenario/[id]",
      "regex": "^/scenario/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/scenario/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/api/admin",
      "regex": "^/api/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin(?:/)?$"
    },
    {
      "page": "/api/comparison",
      "regex": "^/api/comparison(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/comparison(?:/)?$"
    },
    {
      "page": "/api/event",
      "regex": "^/api/event(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/event(?:/)?$"
    },
    {
      "page": "/api/export",
      "regex": "^/api/export(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/export(?:/)?$"
    },
    {
      "page": "/api/init-db",
      "regex": "^/api/init\\-db(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/init\\-db(?:/)?$"
    },
    {
      "page": "/api/session",
      "regex": "^/api/session(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/session(?:/)?$"
    },
    {
      "page": "/comparison",
      "regex": "^/comparison(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/comparison(?:/)?$"
    },
    {
      "page": "/consent",
      "regex": "^/consent(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/consent(?:/)?$"
    },
    {
      "page": "/finish",
      "regex": "^/finish(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/finish(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/mini-game/1",
      "regex": "^/mini\\-game/1(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/mini\\-game/1(?:/)?$"
    },
    {
      "page": "/mini-game/2",
      "regex": "^/mini\\-game/2(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/mini\\-game/2(?:/)?$"
    },
    {
      "page": "/mini-game/3",
      "regex": "^/mini\\-game/3(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/mini\\-game/3(?:/)?$"
    },
    {
      "page": "/mini-game/4",
      "regex": "^/mini\\-game/4(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/mini\\-game/4(?:/)?$"
    },
    {
      "page": "/reflection",
      "regex": "^/reflection(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/reflection(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}